      "esbuild@>=0.27.0 <0.28.1": "^0.28.1",
      "fast-uri@>=3.0.0 <4.0.0": "^3.1.5",
      "flatted@>=3.0.0 <4.0.0": "^3.4.2",
      "js-yaml@>=3.0.0 <4.0.0": "^3.15.1",
      "js-yaml@>=4.0.0 <5.0.0": "^4.3.1",
      "lodash@>=4.0.0 <5.0.0": "^4.18.0",
      "minimatch@>=3.0.0 <4.0.0": "^3.1.3",
      "minimatch@>=9.0.0 <10.0.0": "^9.0.7",
      "picomatch@>=4.0.0 <5.0.0": "^4.0.4",
      "serialize-javascript@>=6.0.0 <7.0.0": "^7.0.7",
      "serialize-javascript@>=7.0.0 <8.0.0": "^7.0.5",
